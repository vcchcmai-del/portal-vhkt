# Sao chép file này thành .env rồi sửa lại các giá trị bên dưới.

# Tài khoản cơ sở dữ liệu
POSTGRES_USER=portal
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=portal

# Chuỗi bí mật để ký token đăng nhập.
# Sinh chuỗi ngẫu nhiên bằng lệnh: openssl rand -hex 32
SECRET_KEY=thay-bang-chuoi-ngau-nhien-64-ky-tu

# Tên miền được phép gọi API. Khi chạy thật, ghi rõ địa chỉ cổng thông tin.
CORS_ORIGINS=http://portal.cncthcm.local

# Production: dùng PostgreSQL managed/external nếu PaaS chỉ chạy một service
# DATABASE_URL=postgresql+psycopg2://portal:MAT_KHAU@HOST:5432/portal
REQUIRE_POSTGRES=0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# Email cảnh báo khi sửa/xoá bản tin hoặc đổi cấu hình website.
# Bỏ trống thì hệ thống vẫn chạy bình thường, chỉ không gửi được email (có ghi log cảnh báo).
#
# Cách lấy SMTP_PASSWORD cho Gmail:
#   1. Bật xác thực 2 bước cho tài khoản Gmail dùng để gửi.
#   2. Vào myaccount.google.com/apppasswords, tạo "Mật khẩu ứng dụng" (App Password) mới.
#   3. Dán chuỗi 16 ký tự đó vào SMTP_PASSWORD bên dưới — KHÔNG dùng mật khẩu đăng nhập Gmail thường.
ALERT_EMAIL_TO=vcchcm.ai@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tai-khoan-gui-di@gmail.com
SMTP_PASSWORD=dan-app-password-16-ky-tu
SMTP_FROM=tai-khoan-gui-di@gmail.com
